# Slack app tokens (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Groq API key
GROQ_API_KEY=gsk_your-groq-api-key

# Slack user ID (e.g. U0123ABCDEF) allowed to use the email feature.
# Leave unset to disable email drafting/sending entirely.
ALLOWED_EMAIL_USER_ID=

# Gmail OAuth credentials/token, as JSON strings. Only needed on deployments
# (e.g. Railway) that don't have local credentials.json/token.json files —
# for local dev, run `npm run authorize-gmail` instead and leave these unset.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_TOKEN_JSON=
